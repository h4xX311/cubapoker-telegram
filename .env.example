# --- Telegram ---
# Token de @BotFather. Es la clave con la que el servidor valida la identidad de
# cada usuario: si cambia, todas las sesiones abiertas fallan.
TELEGRAM_BOT_TOKEN=

# --- Base de datos ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cubapoker

# --- Mini App ---
# Debe coincidir EXACTAMENTE con la URL registrada en @BotFather (/newapp) y
# terminar en la raiz, sin /game ni /deposit.
MINI_APP_URL=https://tu-dominio.com

# ============================================================================
# PAGOS
# ============================================================================
#
# MODO SIMULACION (el de ahora)
#
#   SIMULATE_PAYMENTS=true   no mueve dinero real. Los depositos acreditan saldo de
#                            prueba y el panel tiene la pantalla de confirmacion.
#   SIMULATE_PAYMENTS=false  exige pasarelas reales conectadas. NO usar hasta que
#                            haya una pasarela de verdad.
#
# Sin definir esta variable, la simulacion esta ACTIVADA. Es lo correcto: arrancar sin
# ella no puede mover dinero.
SIMULATE_PAYMENTS=true

# Clave para confirmar pagos desde el panel de pruebas.
SIMULATION_SECRET=cambia-esto-por-una-clave-larga

# ----------------------------------------------------------------------------
# ALLOW_SIMULATED_WITHDRAWALS: dejalo en false.
# ----------------------------------------------------------------------------
#
# Con esta variable en `false` (que es como esta ahora), aprobar un retiro desde el
# panel del operador se RECHAZA con un 409, y el motivo dice esto:
#
#     El sistema esta en MODO SIMULACION y este retiro no se puede liquidar. Marcarlo
#     como pagado haria que el panel dijera que el sistema ha procesado un pago, y ese
#     dinero no sale de ningun sitio: el operador lo pagaria de su bolsillo.
#
# Por que hace falta un freno, si el boton ya dice "aprobar":
#
# Ese endpoint NO mueve dinero. Solo marca la orden como pagada y descuenta el saldo,
# porque el envio del USDT lo hace el operador por fuera. Sin freno, una orden de
# simulacion en el panel es INDISTINGUIBLE de una de verdad, el operador ve
# "liquidado" y paga. Eso no es un descuadre contable: es dinero real pagado a cambio
# de nada.
#
# Ponerla a `true` exige ADEMAS `confirmarSimulado: true` en cada peticion. Con una sola
# de las dos, la otra se cumple sola, y eso seria justo el accidente que hay que evitar:
# un boton que dijera "liquidar simulado" y lo hiciera sin preguntar. Esta variable
# existe para cuando liquides en simulacion A PROPOSITO, habiendo pagado de verdad; cada
# vez que pase, queda un aviso con nivel ERROR y el importe y el usuario.
ALLOW_SIMULATED_WITHDRAWALS=false

# Clave de las rutas administrativas (estadisticas, aprobacion de retiros).
# Si no se define, esas rutas quedan deshabilitadas.
ADMIN_API_KEY=

# --- Pasarelas reales (futuro) ---
# Solo cuando SIMULATE_PAYMENTS=false. Necesitan cuenta de empresa.
ENZONA_CLIENT_ID=
ENZONA_CLIENT_SECRET=
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=

# ============================================================================
# DEPOSITO EN USDT: SOLO TRC20
# ============================================================================
#
# Las otras cuatro redes (ERC20, BEP20, Polygon, Solana) dan un error explicito y no se
# pueden usar para depositar. No es una decision de comodo: TRC20 es la UNICA de las
# cinco que tiene memo, y sin memo un deposito no se puede atribuir a ninguna cuenta de
# forma fiable. Con memo, la direccion de deposito identifica la cuenta y el pago se
# puede verificar contra la cadena.
#
# TRONGRID_API_KEY: clave de https://trongrid.io para consultar la cadena.
TRONGRID_API_KEY=

# Direccion (o pool de direcciones) de TRON donde llegan los depositos.
USDT_DEPOSIT_ADDRESS=

# Contrato USDT en TRON. Compruebala antes de usarla: multiplicar con una direccion
# equivocada es un robo directo.
USDT_CONTRACT_ADDRESS=

# --- Servidor ---
PORT=3000
NODE_ENV=production

# ============================================================================
# QUE ESTA LISTO Y QUE NO
# ============================================================================
#
# LISTO para arrancar en modo simulacion:
#   - motor de poker con botes laterales, bots y campos multi-mesa de 300 a 500
#   - circuito de deposito USDT TRC20 con memo
#   - panel de operador con estadisticas y gestion de retiros
#   - limites de retiro (ver src/services/payment/withdrawal.rules.ts)
#
# PENDIENTE, y no se puede resolver desde aqui:
#   - Revision legal por abogado. Hay borradores en LEGAL/, pero no son asesoria legal.
#   - Autoexclusion y limites de perdida: ya estan escritos en LEGAL/IMPLEMENTATION.md
#     pero no implementados. Es trabajo directo, sin bloqueos.
#   - Pasarelas reales (EnZona, QvaPay, epusdt): necesitan cuenta de empresa.
#
# Y una nota sobre el repo de masterai-top/TexasHoldem-Poker-Complete-Solution, que se
# planteo como base: su licencia es solo para aprendizaje e investigacion, con
# "All Rights Reserved" y uso comercial de pago. No se puede copiar y rebrandear para
# un producto comercial. Ademas es Unity y C++, y un Mini App de Telegram es web: no
# seria el mismo producto ni se podria ejecutar dentro de Telegram.