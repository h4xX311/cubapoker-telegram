# --- Telegram ---
# Token de @BotFather. Es la clave con la que el servidor valida la
# identidad de cada usuario: si cambia, todas las sesiones abiertas fallan.
TELEGRAM_BOT_TOKEN=

# --- Base de datos ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cubapoker

# --- Mini App ---
# Debe coincidir EXACTAMENTE con la URL registrada en @BotFather (/newapp)
# y terminar en la raiz, sin /game ni /deposit.
MINI_APP_URL=https://tu-dominio.com

# --- Pagos ---
# SIMULATE_PAYMENTS=true  -> no mueve dinero real, pantalla de prueba integrada
# SIMULATE_PAYMENTS=false -> exige pasarelas reales conectadas (no usar aun)
SIMULATE_PAYMENTS=true

# Clave para confirmar pagos desde el panel de pruebas.
# En produccion debe ser larga y aleatoria.
SIMULATION_SECRET=cambia-esto-por-una-clave-larga

# Clave de las rutas administrativas (estadisticas, aprobacion de retiros).
# Si no se define, esas rutas quedan deshabilitadas.
ADMIN_API_KEY=

# --- Pasarelas reales (futuro) ---
# Solo cuando SIMULATE_PAYMENTS=false
ENZONA_CLIENT_ID=
ENZONA_CLIENT_SECRET=
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=

# --- Blockchain (para detectar depositos reales) ---
TRONGRID_API_KEY=
USDT_CONTRACT_ADDRESS=

# --- Servidor ---
PORT=3000
NODE_ENV=production

# Bypass de autenticacion. DEJAR EN false/false EN PRODUCCION.
# Si se activa en un entorno publico, cualquiera suplanta cualquier cuenta.
DEV_AUTH_BYPASS=false
DEV_AUTH_ID=
